{
  "name": "create-wasm-app",
  "version": "0.1.0",
  "description": "create an app to consume rust-generated wasm packages",
  "main": "index.js",
  "bin": {
    "create-wasm-app": ".bin/create-wasm-app.js"
  },
  "scripts": {
    "start": "wasm-pack build --target bundler --out-dir pkg && webpack serve",
    "watch:wasm": "cargo watch -s 'wasm-pack build --target bundler --out-dir pkg --dev'",
    "dev": "run-p watch:wasm start",
    "build:wasm": "wasm-pack build --target bundler --out-dir pkg",
    "build": "npm run build:wasm && webpack --mode production"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rustwasm/create-wasm-app.git"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "rust",
    "webpack"
  ],
  "author": "Ashley Williams <ashley666ashley@gmail.com>",
  "license": "(MIT OR Apache-2.0)",
  "bugs": {
    "url": "https://github.com/rustwasm/create-wasm-app/issues"
  },
  "homepage": "https://github.com/rustwasm/create-wasm-app#readme",
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "copy-webpack-plugin": "^13.0.1",
    "hello-wasm-pack": "^0.1.0",
    "npm-run-all": "^4.1.5",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "game-of-life": "file:../pkg"
  }
}
